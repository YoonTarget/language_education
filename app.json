{
  "expo": {
    "name": "할머니 한글",
    "slug": "haelmoni-hangul",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF9F0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.haelmoni.hangul"
    },
    "android": {
      "package": "com.haelmoni.hangul",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF9F0"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "notification": {
      "color": "#FF7043"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#FF7043",
          "defaultChannel": "daily-learning-reminders"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f5181bbe-ab8a-4d39-88e9-49b6e2ea8349"
      }
    },
    "owner": "yoontarget"
  }
}
